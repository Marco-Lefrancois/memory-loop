# ==============================================================================
# 🔑 MEMORY LOOP (mLoop) — Modèle de Variables d'Environnement (.env.example)
# ==============================================================================
# Instructions :
# 1. Copiez ce fichier sous le nom '.env' à la racine du projet :
#    cp .env.example .env   (ou 'Copy-Item .env.example .env' en PowerShell)
# 2. Remplissez les clés d'API nécessaires à votre environnement de travail.
# 3. Ne committez JAMAIS le fichier '.env' réel (il est ignoré par .gitignore).
# ==============================================================================

# --- Antigravity & IDE Configuration ---
OPENCODE_CONFIG="opencode.json"
EDITOR="code"

# --- Fournisseurs IA Directs (Free Tier & Clés directes) ---
# Google AI Studio : https://aistudio.google.com/app/apikey
GOOGLE_AI_STUDIO_KEY=your_google_ai_studio_key_here
GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key_here

# DeepSeek AI : https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Groq Cloud : https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Mistral AI : https://mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# OpenCode Zen : https://opencode.ai/
OPENCODE_ZEN_KEY=your_opencode_zen_key_here

# OpenRouter : https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- LiteLLM Proxy / Nmédia Cloud ---
LITELLM_BASE_URL=https://api-ia.nmedia.ca/v1
LITELLM_API_KEY=your_litellm_api_key_here
LITELLM_API_KEY_PERSO=your_litellm_api_key_perso_here
LITELLM_API_KEY_METRO=your_litellm_api_key_metro_here
LITELLM_API_KEY_BOIRE=your_litellm_api_key_boire_here
MLOOP_ALLOW_CROSS_KEY=false

# --- GitHub Integration (MCP & Synchronisation) ---
GITHUB_TOKEN=your_github_token_here

# --- Jira Cloud Integration ---
# Configuration Jira standard
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@domain.com
JIRA_API_TOKEN=your_jira_api_token_here

# Profil Jira Nmédia
JIRA_NMEDIA_HOSTNAME=your-domain.atlassian.net
JIRA_NMEDIA_EMAIL=your-email@nmedia.ca
JIRA_NMEDIA_TOKEN=your_nmedia_jira_token_here

# Profil Jira Métro
JIRA_METRO_HOSTNAME=your-domain.atlassian.net
JIRA_METRO_EMAIL=your-email@metro.ca
JIRA_METRO_TOKEN=your_metro_jira_token_here

# --- Outils de Recherche & Scraping ---
# Firecrawl : https://www.firecrawl.dev/
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# SearXNG (Instance locale ou distante)
SEARXNG_URL=http://localhost:8080

# Context7 (Documentation MCP) : https://context7.com/
CONTEXT7_API_KEY=your_context7_api_key_here

# --- UI & Design ---
# Google Stitch : https://stitch.withgoogle.com/
GOOGLE_STITCH_API_KEY=your_google_stitch_api_key_here
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id_here

# Figma API : https://www.figma.com/
FIGMA_API_KEY=your_figma_api_key_here
