{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "tokyonight",
  "diff_style": "auto",
  "cursor": {
    "style": "block",
    "blinking": true
  },
  "scroll_speed": 3,
  "scroll_acceleration": {
    "enabled": true
  },
  "mouse": true,
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.3
  },
  "keybinds": {
    "switch_agent": "tab",
    "command_list": "ctrl+p"
  }
}
