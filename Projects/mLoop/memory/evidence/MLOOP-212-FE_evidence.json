    {
      "decision_id": "D-212-02",
      "decision": "Serveur annonce capabilities.extensions symetriques {mimeTypes: [text/html;profile=mcp-app]} via ui_server_capabilities() (registre unique revoyable).",
      "grounded_in": "Plan 212-FE §2 / SEP-1865 SDK advertise"
    },
    {
      "decision_id": "D-212-03",
      "decision": "Strip des 3 balises link Google Fonts au service de l artefact Archify showcase (In-Scope zero CDN); DrawDB servi par render_schema_page autonome.",
      "grounded_in": "Recit In-Scope + ADR-007 micro-grill"
    },
    {
      "decision_id": "D-212-04",
      "decision": "Repli dimensionnel UI_MIN_WIDTH_PX=320 dans le registre partagé (banniere non bloquante, liens declaratifs 4 etats); repli local http://localhost:8081/ (DrawDB) et http://localhost:8080/api/archify/html (cockpit).",
      "grounded_in": "ADR-007 212-Q2"
    },
    {
      "decision_id": "D-212-05",
      "decision": "Zoom/pan shell opt-in (zoomTarget) uniquement sur DrawDB #schema-container; Archify conserve son pan/zoom natif; mise a jour en place via postMessage project_changed (renderSchema, zero location.reload, garde event.source !== window.parent).",
      "grounded_in": "ADR-007 212-Q1 + recit Scenario 6"
    }
