{
  "$schema": "https://opencode.ai/schema.json",
  "project": "{{PROJECT_NAME}}",
  "version": "1.0.0",
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "edit": "allow",
    "read": "allow",
    "external_directory": {
      "*": "allow"
    },
    "bash": {
      "*": "allow"
    }
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "bin/**",
      "obj/**",
      "reference/**",
      "memory/cache/**",
      "memory/tmp/**"
    ]
  }
}
